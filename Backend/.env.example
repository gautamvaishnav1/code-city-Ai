# ---------- Server ----------
NODE_ENV=development
PORT=5000

# ---------- MongoDB ----------
MONGO_URI=mongodb://127.0.0.1:27017/software-world

# ---------- Auth ----------
# JWT_SECRET MUST be 32+ random chars in production (server refuses to start otherwise)
JWT_SECRET=please-change-me-to-a-long-random-string
# Short-lived access token — clients refresh via POST /api/v1/auth/refresh
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
LOG_STREAM_TICKET_TTL_MS=30000

# ---------- CORS ----------
# Comma-separated list of allowed origins. " *" is forbidden in production.
CORS_ORIGINS=http://localhost:3000

# ---------- GitHub ----------
# Optional but strongly recommended (raises API rate limit from 60 to 5000/h).
# Create one at https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=

# ---------- LLM (OpenAI-compatible) ----------
# Leave LLM_API_KEY empty to run in deterministic heuristic mode (no external calls).
# Works with OpenAI, OpenRouter, Groq, Ollama... anything speaking /chat/completions.
#   OpenAI:     https://platform.openai.com/api-keys      -> model: gpt-5.6
#   OpenRouter: https://openrouter.ai/settings/keys       -> model: anthropic/claude-opus-5
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-5.6
LLM_TIMEOUT_MS=60000

# ---------- Parser safety limits ----------
MAX_REPO_FILES=1500
MAX_FILE_SIZE_KB=256

# ---------- OAuth (optional) ----------
# Google Cloud Console -> Credentials -> OAuth client ID (Web application)
#   Redirect URI: http://localhost:5000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub -> Settings -> Developer settings -> OAuth Apps
#   Callback URL: http://localhost:5000/api/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
PUBLIC_BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# ---------- SMTP for OTP emails (optional) ----------
# Empty = OTPs printed to server console and returned as devCode (dev mode).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Software World <no-reply@software-world.local>
